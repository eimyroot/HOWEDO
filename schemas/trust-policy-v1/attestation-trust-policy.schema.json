{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nulleimy/HOWEDO/schemas/trust-policy-v1/attestation-trust-policy.schema.json",
  "title": "HOWEDO Attestation Trust Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_version",
    "policy_id",
    "policy_digest",
    "allowed_verifiers",
    "allowed_issuers",
    "allowed_identity_patterns",
    "allowed_repositories",
    "allowed_workflows",
    "allowed_ref_patterns",
    "allowed_triggers",
    "allowed_predicate_types",
    "allowed_artifact_versions",
    "require_conformant_status",
    "require_transparency_log",
    "require_execution_sha_matches_artifact_checkout"
  ],
  "properties": {
    "policy_version": {
      "const": "howedo.attestation-trust-policy.v1"
    },
    "policy_id": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "allowed_verifiers": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowed_issuers": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowed_identity_patterns": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowed_repositories": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowed_workflows": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowed_ref_patterns": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowed_triggers": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowed_predicate_types": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "allowed_artifact_versions": { "$ref": "#/$defs/nonEmptyUniqueStrings" },
    "require_conformant_status": { "type": "boolean" },
    "require_transparency_log": { "type": "boolean" },
    "require_execution_sha_matches_artifact_checkout": { "type": "boolean" }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
