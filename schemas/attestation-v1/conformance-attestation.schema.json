{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/nulleimy/HOWEDO/schemas/attestation-v1/conformance-attestation.schema.json",
  "title": "HOWEDO Conformance Attestation Statement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["_type", "subject", "predicateType", "predicate"],
  "properties": {
    "_type": {
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "digest"],
        "properties": {
          "name": {
            "const": "howedo.adapter-conformance-artifact.v1"
          },
          "digest": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256"],
            "properties": {
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      }
    },
    "predicateType": {
      "const": "https://github.com/nulleimy/HOWEDO/attestations/adapter-conformance/v1"
    },
    "predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "artifactVersion", "conformance", "evidenceRefs"],
      "properties": {
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapterId", "adapterVersion", "manifestDigest", "runtimeFamily"],
          "properties": {
            "adapterId": {"type": "string", "minLength": 1},
            "adapterVersion": {"type": "string", "minLength": 1},
            "manifestDigest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "runtimeFamily": {"type": "string", "minLength": 1}
          }
        },
        "artifactVersion": {
          "const": "howedo.adapter-conformance-artifact.v1"
        },
        "conformance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["checkCount", "passedCount", "status"],
          "properties": {
            "checkCount": {"type": "integer", "const": 11},
            "passedCount": {"type": "integer", "minimum": 0, "maximum": 11},
            "status": {"enum": ["CONFORMANT", "NON_CONFORMANT"]}
          }
        },
        "evidenceRefs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    }
  }
}
