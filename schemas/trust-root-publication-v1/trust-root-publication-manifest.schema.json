{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://howedo.dev/schemas/trust-root-publication-v1/trust-root-publication-manifest.schema.json",
  "title": "HOWEDO Trust Root Publication Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "consistent_snapshot",
    "consumer_profile_id",
    "manifest_digest",
    "manifest_version",
    "metadata_base_url",
    "policy_digest",
    "publication_id",
    "roles",
    "root_expires",
    "root_history",
    "spec_version",
    "target_base_url",
    "target_path",
    "verified_at"
  ],
  "properties": {
    "consistent_snapshot": {"type": "boolean"},
    "consumer_profile_id": {"type": "string", "minLength": 1},
    "manifest_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifest_version": {"const": "howedo.trust-root-publication-manifest.v1"},
    "metadata_base_url": {"type": "string", "format": "uri"},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "publication_id": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyids", "name", "threshold"],
        "properties": {
          "keyids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "name": {"enum": ["root", "snapshot", "targets", "timestamp"]},
          "threshold": {"type": "integer", "minimum": 1}
        }
      }
    },
    "root_expires": {"type": "string"},
    "root_history": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["digest", "version"],
        "properties": {
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "version": {"type": "integer", "minimum": 1}
        }
      }
    },
    "spec_version": {"type": "string"},
    "target_base_url": {"type": "string", "format": "uri"},
    "target_path": {"type": "string", "minLength": 1},
    "verified_at": {"type": "string"}
  }
}
